
pipeline {
    agent any

    stages {

        stage('Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/adityaghaywat-cmd/java2.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'

                deploy adapters: [tomcat9(
                    alternativeDeploymentContext: '',
                    credentialsId: 'tomcat',
                    path: '',
                    url: 'http://localhost:8083'
                )],
                contextPath: 'java3',
                war: 'target/*.war'
            }
        }

        stage('Deploy') {
            steps {

                sh '/opt/tomcat/apache-tomcat-9.0.118/bin/shutdown.sh || true'

                sh 'rm -rf /opt/tomcat/apache-tomcat-9.0.118/webapps/webapp'

                sh 'rm -f /opt/tomcat/apache-tomcat-9.0.118/webapps/webapp.war'

                sh 'cp -r target/webapp /opt/tomcat/apache-tomcat-9.0.118/webapps/'

                sh 'cp target/webapp.war /opt/tomcat/apache-tomcat-9.0.118/webapps/'

                sh '/opt/tomcat/apache-tomcat-9.0.118/bin/startup.sh'
            }
        }
    }
}
